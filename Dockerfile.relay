# syntax=docker/dockerfile:1

FROM golang:1.23-bookworm AS build

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w -X main.Version=${VERSION}" \
    -o /out/atterm-relay \
    ./cmd/atterm-relay

FROM alpine:3.20

RUN apk add --no-cache su-exec \
 && addgroup -S atterm \
 && adduser -S -G atterm atterm

WORKDIR /app

COPY --from=build /out/atterm-relay /usr/local/bin/atterm-relay
COPY web ./web
COPY cmd/atterm-relay/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Container starts as root so the entrypoint can chown the bind-mounted
# persistence directory; the entrypoint then drops to the atterm user
# via su-exec before exec'ing the relay binary.

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["--addr", ":8080", "--web", "/app/web"]
